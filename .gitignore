# Environment files and credentials: examples must be reviewed before opt-in.
.env
.env.*
*.env
.envrc
credentials.json
credentials*.json
secrets.json
secrets*.json
secrets.yaml
secrets.yml
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
.aws/
.ssh/
.npmrc
.pypirc

# Dependencies, bytecode, build output and caches.
.venv/
venv/
env/
node_modules/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.hypothesis/
.tox/
.nox/
.coverage*
htmlcov/
coverage/
dist/
build/
*.egg-info/

# Local tools, Obsidian preferences/themes and editor state.
.codex/
.agents/
.obsidian/
.trash/
.idea/
.DS_Store
Thumbs.db
Desktop.ini

# Temporary files and runtime locks; dependency lockfiles remain versionable.
*.tmp
*.temp
*.log
*.pid
*.swp
*.swo
*~
*.bak
*.orig
*.rej
.write.lock
tmp/
temp/

# Local generated products and operational evidence are not the factory source.
/proyectos/*
!/proyectos/.gitkeep
/project-state/*
!/project-state/README.md
!/project-state/.gitkeep
/runs/
/backups/
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat
.gitignore
